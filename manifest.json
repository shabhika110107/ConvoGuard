{
  "manifest_version": 3,
  "name": "AI Chat Monitor",
  "version": "1.0",
  "description": "Monitors chat messages for sensitive keywords and alerts users.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["*://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["emailjs.min.js", "content.js"],
      "css": ["content.css"]
    }
  ]
}
